# Copy to .env for local runs outside Docker Compose. Compose sets these
# itself, so the file is only needed when running `go run ./cmd/...` directly.

# --- shared -----------------------------------------------------------------
DATABASE_URL=postgres://ocee:ocee@localhost:5432/ocee?sslmode=disable
REDIS_ADDR=localhost:6379

# --- api --------------------------------------------------------------------
API_ADDR=:8080
MAX_CODE_BYTES=64000
MAX_STDIN_BYTES=64000
SHUTDOWN_GRACE=15s

# --- worker -----------------------------------------------------------------
# One container per slot. The real ceiling is host RAM: each slot can hold a
# container using up to MEMORY_LIMIT_MB.
WORKER_CONCURRENCY=8
# Set false in air-gapped environments; images must then already be present.
PULL_IMAGES=true

# --- sandbox limits ---------------------------------------------------------
MEMORY_LIMIT_MB=256
CPU_LIMIT=1.0
PIDS_LIMIT=128
RUN_TIMEOUT=10s
COMPILE_TIMEOUT=20s
TMPFS_SIZE_MB=64
MAX_OUTPUT_BYTES=1048576

# --- webhooks ---------------------------------------------------------------
WEBHOOK_TIMEOUT=10s
WEBHOOK_MAX_RETRIES=5
# Webhook URLs pointing at private/loopback addresses are rejected as SSRF.
# Set true only to test against a receiver on your own machine.
WEBHOOK_ALLOW_PRIVATE=false
